import("//build/config/features.gni")
import("//build/ohos.gni")
import("//build/test.gni")
import("//foundation/graphic/graphic_3d/lume/lume_config.gni")

module_output_path = "graphic_3d/graphic_3d/lume_gs_test"

ohos_unittest("lume_gs_test") {
  module_out_path = module_output_path
  
  sources = [
    "src/GsTest.cpp",
    "../mock/ai_edit_loader_stub.cpp",
  ]

  include_dirs = [
    "${LUME_ROOT}/LumeGS/api",
    "${LUME_ROOT}/LumeGS/api/plugin_gs/ecs/components",
    "${LUME_ROOT}/LumeGS/api/plugin_gs/ecs/systems",
    "${LUME_ROOT}/LumeGS/api/plugin_gs/render",
    "${LUME_ROOT}/LumeGS/api/plugin_gs",
    "${LUME_ROOT}/LumeGS/assets",
    "${LUME_ROOT}/LumeGS/src",
    "${LUME_ROOT}/LumeGS/src/render",
    "${LUME_ROOT}/LumeGS/src/render/GsAIEdit",
    "${LUME_ROOT}/LumeGS/plugin_gs",
  ]

  deps = [
    "//foundation/graphic/graphic_3d/lume/LumeGS:3d_gs_src",
    "${LUME_CORE_PATH}:AGPEcshelperApi",
    "${LUME_CORE_PATH}:AGPBaseApi",
    "${LUME_CORE_PATH}:AGPEngineApi",
    "${LUME_CORE3D_PATH}:AGP3DApi",
    "${LUME_RENDER_PATH}:AGPRenderApi",
    "${LUME_META_PATH}:AGPMetaApi",
    "${LUME_SCENE_PATH}:AGPSceneApi",
  ]

  defines = [
    "RENDER_HAS_GLES_BACKEND=1",
    "RENDER_HAS_VULKAN_BACKEND=1",
    "VMA_STATS_STRING_ENABLED=0",
    "VMA_STATIC_VULKAN_FUNCTIONS=0",
    "GS_EMBEDDED_ASSETS_ENABLED=1",
    "CORE_PLUGIN=1",
    "CORE_DYNAMIC=1",
  ]

  if (target_cpu == "arm") {
    defines += [
      "PLATFORM_CORE_ROOT_PATH=/system/lib/",
      "PLATFORM_CORE_PLUGIN_PATH=/system/lib/graphics3d",
      "PLATFORM_APP_ROOT_PATH=/system/lib/",
      "PLATFORM_APP_PLUGIN_PATH=/system/lib/graphics3d",
    ]
  }

  if (target_cpu == "arm64") {
    defines += [
      "PLATFORM_CORE_ROOT_PATH=/system/lib64/",
      "PLATFORM_CORE_PLUGIN_PATH=/system/lib64/graphics3d/",
      "PLATFORM_APP_ROOT_PATH=/system/lib64/",
      "PLATFORM_APP_PLUGIN_PATH=/system/lib64/graphics3d/",
    ]
  }

  defines += [ "RENDER_PUBLIC=__attribute__((visibility(\"default\")))" ]
  defines += [ "LIB_ENGINE_CORE=\"libAGPDLL.z.so\"" ]

  if (BUILDTYPE == "Release") {
    defines += [ "PLUGIN_LOG_NO_DEBUG=0" ]
  }

  if (BUILDTYPE == "MinSizeRel") {
    defines += [ "PLUGIN_LOG_NO_DEBUG=0" ]
  }

  if (BUILDTYPE == "RelWithDebInfo") {
    defines += [ "PLUGIN_LOG_NO_DEBUG=0" ]
  }

  if (LUME_OHOS_BUILD) {
    defines += [ "__OHOS_PLATFORM__" ]
  }

  external_deps = [
    "ability_runtime:ability_manager",
    "ability_runtime:app_context",
    "ability_runtime:data_ability_helper",
    "ability_runtime:napi_base_context",
    "ability_runtime:napi_common",
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "googletest:gmock",
    "googletest:gtest",
    "hilog:libhilog",
    "hitrace:hitrace_meter",
    "graphic_2d:EGL",
    "graphic_2d:GLESv3",
    "vulkan-headers:vulkan_headers",
    "egl:libEGL",
    "opengles:libGLES",
  ]

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
    "-Wno-nullability-completeness",
    "-Wno-ignored-qualifiers",
    "-Wno-switch",
    "-Wno-header-hygiene",
    "-Wno-inconsistent-missing-override",
    "-Wno-global-constructors",
  ]

  resource_config_file = "//foundation/graphic/graphic_3d/lume/LumeGS/test/resource/ohos_test.xml"

  part_name = "graphic_3d"
  subsystem_name = "graphic"
}

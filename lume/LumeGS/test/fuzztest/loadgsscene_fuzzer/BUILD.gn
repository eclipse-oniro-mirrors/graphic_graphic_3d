import("//build/config/features.gni")
import("//build/test.gni")
import("//foundation/graphic/graphic_3d/lume/lume_config.gni")

module_output_path = "graphic_3d/lume/LumeGS"
load_gs_scene_path = "//foundation/graphic/graphic_3d/lume/LumeGS"

ohos_fuzztest("LoadGsSceneFuzzTest") {
  testonly = true

  fuzz_config_file = "${load_gs_scene_path}/test/fuzztest/loadgsscene_fuzzer"

  module_out_path = module_output_path

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
    "-Dprivate=public",
    "-Dprotected=public",
  ]

  sources = [
    "./loadgsscene_fuzzer.cpp",
    "./mock/mockenv_fuzzer.cpp",
    "../../mock/ai_edit_loader_stub.cpp",
  ]

  include_dirs = [
    "./mock",
    "//foundation/graphic/graphic_3d/lume/LumeGS/api",
    "//foundation/graphic/graphic_3d/lume/LumeGS/api/plugin_gs/ecs/components",
    "//foundation/graphic/graphic_3d/lume/LumeGS/api/plugin_gs/ecs/systems",
    "//foundation/graphic/graphic_3d/lume/LumeGS/api/plugin_gs/util",
    "//foundation/graphic/graphic_3d/lume/LumeGS/src/loader",
    "..",
  ]

  configs = [
    "//foundation/graphic/graphic_3d/lume/LumeGS:gs_api",
    "//foundation/graphic/graphic_3d/lume/LumeGS:gs_config",
  ]

  defines = [
    "FUZZTEST_LIBFUZZER=1",
  ]

  deps = [
    "//foundation/graphic/graphic_3d/lume/LumeGS:3d_gs_src",
    "${LUME_CORE_PATH}:AGPEcshelperApi",
    "${LUME_CORE_PATH}:AGPBaseApi",
    "${LUME_CORE_PATH}:AGPEngineApi",
    "${LUME_CORE3D_PATH}:AGP3DApi",
    "${LUME_RENDER_PATH}:AGPRenderApi",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
  ]

  part_name = "graphic_3d"
  subsystem_name = "graphic"
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = [
    # deps file
    ":LoadGsSceneFuzzTest",
  ]
}
###############################################################################

#version 460 core
#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable

#include "common/gs_common.h"
#include "common/gs_struct_common.h"

layout(set = 0, binding = 0, std430) writeonly buffer uStatusBuffer
{
    GsRenderStatusUbo statusUbo;
};

layout(push_constant, std430) uniform uPushConstant
{
    GsRenderStatusUbo renderStatus;
};

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
void main()
{
    statusUbo.jitterFrameRendered = renderStatus.jitterFrameRendered;
    statusUbo.frameIdx = renderStatus.frameIdx;
    statusUbo.renderScaleFactor = renderStatus.renderScaleFactor;
    statusUbo.convertColorSrgb = renderStatus.convertColorSrgb;
    statusUbo.DRSScale = renderStatus.DRSScale;
    statusUbo.depthPassEnabled = renderStatus.depthPassEnabled;
    statusUbo.sharpeningCoeff = renderStatus.sharpeningCoeff;
    statusUbo.enableXegUpscale = renderStatus.enableXegUpscale;
}

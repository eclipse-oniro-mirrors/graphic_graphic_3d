layout(push_constant, std430) uniform uEditPushConstant {
    GsEditPushConstantData uPc;
};

GsSplatData GetSplatData(const uint readIndex)
{
    // if true, read from 0 and write to 1
    const bool writeToBuffer1 = uPc.editCommon.bufferFlipIndex == 1u;
    const uint editPassIndex = uPc.editCommon.editPassIndex;

    if (editPassIndex == 0) {
        // first pass, read from immutablie input
        return gsData[readIndex];
    } else {
        // not a first pass, read from ping-pong buffers
        if (writeToBuffer1) {
            return editGsData0[readIndex];
        } else {
            return editGsData1[readIndex];
        }
    }
}

bool IsSplatSelected(const uint readIndex)
{
    return selectionMask[readIndex + 1u] == 1u;
}

layout(local_size_x = GS_EDIT_WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;
void main()
{
    const uint globalId = gl_GlobalInvocationID.x;

    if (globalId >= indirectCounter.prevCounter) {
        return;
    }

    const vec4 color = uintBitsToFloat(uvec4(uPc.data[0u], uPc.data[1u], uPc.data[2u], uPc.data[3u]));
    const uint colorMode = uPc.data[4u];

    GsSplatData readSplatData = GetSplatData(globalId);

    if (IsSplatSelected(globalId)) {
        if (colorMode == 0u) {
            // replace
            readSplatData.covBColorPacked.w = uintBitsToFloat(packUnorm4x8(color.abgr));
        } else if (colorMode == 1u) {
            // multiply
            const vec4 rgba = unpackUnorm4x8(floatBitsToUint(readSplatData.covBColorPacked.w)).abgr;
            readSplatData.covBColorPacked.w = uintBitsToFloat(packUnorm4x8(rgba * color.abgr));
        } else if (colorMode == 2u) {
            // add
            const vec4 rgba = unpackUnorm4x8(floatBitsToUint(readSplatData.covBColorPacked.w)).abgr;
            readSplatData.covBColorPacked.w = uintBitsToFloat(packUnorm4x8(rgba + color.abgr));
        }
    }

    atomicAdd(indirectCounter.counter, 1u);

    const bool writeToBuffer1 = uPc.editCommon.bufferFlipIndex == 1u;

    if (writeToBuffer1) {
         editGsData1[globalId] = readSplatData;
    } else {
         editGsData0[globalId] = readSplatData;
    }
}

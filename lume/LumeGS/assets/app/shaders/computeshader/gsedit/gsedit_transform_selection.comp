layout(push_constant, std430) uniform uEditPushConstant {
    GsEditPushConstantData uPc;
};

GsSplatData GetSplatData(const uint readIndex)
{
    // if true, read from 0 and write to 1
    const bool writeToBuffer1 = uPc.editCommon.bufferFlipIndex == 1u;
    const uint editPassIndex = uPc.editCommon.editPassIndex;

    if (editPassIndex == 0) {
        // first pass, read from immutablie input
        return gsData[readIndex];
    } else {
        // not a first pass, read from ping-pong buffers
        if (writeToBuffer1) {
            return editGsData0[readIndex];
        } else {
            return editGsData1[readIndex];
        }
    }
}


bool IsSplatSelected(const uint readIndex)
{
    return selectionMask[readIndex + 1u] == 1u;
}

void TransformSplat(const mat4 tmat, inout GsSplatData splatData)
{
    const vec4 transformedPos = tmat * vec4(splatData.positionOpacity.xyz, 1.0f);
    splatData.positionOpacity.xyz = transformedPos.xyz;

    const mat3 M = mat3(tmat);
    const vec3 covA = splatData.covAScale.xyz;
    const vec3 covB = splatData.covBColorPacked.xyz;

    const mat3 V = mat3(covA.x, covA.y, covA.z, covA.y, covB.x, covB.y, covA.z, covB.y, covB.z);

    const mat3 covTransformed = M * V * transpose(M);
    splatData.covAScale.xyz = vec3(covTransformed[0][0], covTransformed[0][1], covTransformed[0][2]);
    splatData.covBColorPacked.xyz = vec3(covTransformed[1][1], covTransformed[1][2], covTransformed[2][2]);
}

layout(local_size_x = GS_EDIT_WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;
void main()
{
    const uint globalId = gl_GlobalInvocationID.x;

    if (globalId >= indirectCounter.prevCounter) {
        return;
    }

    const mat4 tmat = mat4(
        uintBitsToFloat(uvec4(uPc.data[0u],  uPc.data[1u],  uPc.data[2u],  uPc.data[3u])),
        uintBitsToFloat(uvec4(uPc.data[4u],  uPc.data[5u],  uPc.data[6u],  uPc.data[7u])),
        uintBitsToFloat(uvec4(uPc.data[8u],  uPc.data[9u],  uPc.data[10u], uPc.data[11u])),
        uintBitsToFloat(uvec4(uPc.data[12u], uPc.data[13u], uPc.data[14u], uPc.data[15u]))
    );

    GsSplatData readSplatData = GetSplatData(globalId);
    const bool isSelected = IsSplatSelected(globalId);

    if (isSelected) {
        TransformSplat(tmat, readSplatData);
    }

	atomicAdd(indirectCounter.counter, 1u);

    const bool writeToBuffer1 = uPc.editCommon.bufferFlipIndex == 1u;

    if (writeToBuffer1) {
         editGsData1[globalId] = readSplatData;
    } else {
         editGsData0[globalId] = readSplatData;
    }
}

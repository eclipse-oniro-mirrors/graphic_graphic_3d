layout(set = 0, binding = 0, std430) restrict buffer selectionIndexBuffer
{
    // mask for selecting splats, write in selection shaders, read everywhere else
    uint selectionMask[];
};

layout(set = 0, binding = 1, std430) restrict buffer indirectDispatchCounterBuffer
{
    // counter and indirect args to keep track of splat counts during editing
    IndirectEditDispatchCounterBuffer indirectCounter;
};

layout(set = 0, binding = 2, std430) readonly restrict buffer actionDataStructBuffer
{
    uint selectIndex[];
};

layout(push_constant, std430) uniform uEditPushConstant {
    GsEditPushConstantData uPc;
};

layout(local_size_x = GS_EDIT_WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;
void main()
{
    const uint globalId = gl_GlobalInvocationID.x;
    const uint length = selectIndex[0];

    if (globalId < length) {
        uint index = selectIndex[globalId + 1u];
        if (index < indirectCounter.counter) {
            // re-computed gssplat data
            if (selectionMask[index + 1] == 0) {
                selectionMask[index + 1] = 1;
                atomicAdd(selectionMask[0], 1u); 
            }
        }
    }
}
#version 460 core
#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable

// includes
#include "3d/shaders/common/3d_dm_structures_common.h"
#include "common/gs_common.h"
#include "common/gs_struct_common.h"

layout(set = 0, binding = 0) uniform sampler2D uDepthTex;

layout(set = 0, binding = 1, r16f) writeonly restrict uniform image2D uOutPrefilterDepth;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main()
{
    const ivec2 uv = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 imageDim = textureSize(uDepthTex, 0);
    if (uv.x >= imageDim.x || uv.y >= imageDim.y) {
        return;
    }

    const int radius = 6;
    float sum = 0.0f;
    int count = 0;
    for (int y = -radius; y <= radius; y++) {
        for (int x = -radius; x <= radius; x++) {
            ivec2 sampleUV = clamp(uv + ivec2(x, y), ivec2(0), imageDim - 1);
            sum += texelFetch(uDepthTex, sampleUV, 0).r;
            count++;
        }
    }

    float filteredDepth = sum / float(count);
    imageStore(uOutPrefilterDepth, uv, vec4(filteredDepth, 0.0, 0.0, 1.0));
}